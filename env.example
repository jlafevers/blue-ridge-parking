# Copy this file to .env locally for testing, and add the same
# variable in Vercel's dashboard (Project Settings -> Environment
# Variables) before deploying.

# Use your TEST secret key first (starts with sk_test_...).
# Switch to your LIVE secret key (starts with sk_live_...) only once
# you're ready to accept real payments.
STRIPE_SECRET_KEY=sk_test_your_key_here
